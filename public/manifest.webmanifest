{
  "name": "TailTots",
  "short_name": "TailTots",
  "description": "Pet care missions, reminders, badges, Kid Bank goals, parent approvals, and neighborhood pet jobs for families.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "background_color": "#fbfaf4",
  "theme_color": "#165a4b",
  "orientation": "any",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Today",
      "short_name": "Today",
      "description": "Open the daily pet care mission board.",
      "url": "/?tab=missions",
      "icons": [{ "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Home Hub",
      "short_name": "Hub",
      "description": "Open the smart display family care board.",
      "url": "/?tab=hub",
      "icons": [{ "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ],
  "categories": ["education", "kids", "productivity", "finance", "lifestyle"]
}
