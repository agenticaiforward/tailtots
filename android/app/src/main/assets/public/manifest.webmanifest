{
  "name": "TailTots",
  "short_name": "TailTots",
  "description": "A parent-guided real-world development platform where kids learn to care, connect, earn, contribute, and create.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "background_color": "#fbfaf4",
  "theme_color": "#165a4b",
  "orientation": "any",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Today",
      "short_name": "Today",
      "description": "Open today's care, earning, and contribution missions.",
      "url": "/?tab=missions",
      "icons": [{ "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Home Hub",
      "short_name": "Hub",
      "description": "Open the family growth and real-world mission hub.",
      "url": "/?tab=hub",
      "icons": [{ "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ],
  "categories": ["education", "kids", "productivity", "finance", "lifestyle"]
}
